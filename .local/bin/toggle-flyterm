#!/usr/bin/env bash
set -e

class=flyterm
special=term

function find_flyterm() {
  hyprctl clients -j | jq -e --arg class "$class" '.[] | select(.class == $class)' >/dev/null
}

function flyterm_animation() {
  # togglespecialworkspace animates the specialWorkspace node itself. Override
  # it as well as its children so it cannot inherit the normal horizontal slide.
  hyprctl keyword animation "specialWorkspace,    1, 1, overshot, slidevert -100%" >/dev/null
  hyprctl keyword animation "specialWorkspaceIn,  1, 1, overshot, slidevert -100%" >/dev/null
  hyprctl keyword animation "specialWorkspaceOut, 1, 2, overshot, slidevert -100%" >/dev/null
}

function normal_animation() {
  hyprctl keyword animation "specialWorkspace,    1, 1, easeOutQuart, slide" >/dev/null
  hyprctl keyword animation "specialWorkspaceIn,  1, 1, easeOutQuart, slide" >/dev/null
  hyprctl keyword animation "specialWorkspaceOut, 1, 1, easeOutQuart, slide" >/dev/null
}

function toggle_term() {
  flyterm_animation
  hyprctl dispatch togglespecialworkspace "$special" || {
    normal_animation
    return 1
  }
  sleep 0.4
  normal_animation
}

if find_flyterm; then
  toggle_term
  exit 0
fi

hyprctl dispatch exec flyterm

for _ in {1..40}; do
  if find_flyterm; then
    toggle_term
    break
  fi
  sleep 0.05
done
