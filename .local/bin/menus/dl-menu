#!/usr/bin/env bash

count=$(copyq count)
limit=$((count < 10 ? count : 10))
url_regex='https?://[^ ]+'

declare -a ITEMS

for ((i = 0; i < limit; i++)); do
  item=$(copyq read $i)
  if [[ $item =~ $url_regex ]]; then
    ITEMS+=("$item")
  fi
done

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
source "$SCRIPT_DIR/_menu"
SELECTED=$(print_list "${ITEMS[@]}" | _dmenu -i -p "Open")

dl "$SELECTED"

